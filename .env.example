# ============================================================
# HermitStash Environment Variables
# Copy to .env or configure in Coolify UI
# All settings also configurable from Admin > Settings panel
# ============================================================

# ---- General ----
NODE_ENV=production
PORT=3000
SITE_NAME=HermitStash
# The addresses a reverse proxy (nginx, Cloudflare, Coolify) connects FROM,
# as IPs or CIDRs — not "true", which is discarded at boot. Loopback is
# trusted already, so leave this empty for a proxy that reaches the server on
# 127.0.0.1. A proxy in its own container connects from the Docker network
# instead: TRUST_PROXY=172.18.0.0/16. A bare IP is taken as a /32 or /128.
TRUST_PROXY=

# Cross-origin allowlist for browser requests originating off the app
# domain (the global allowlist that includes /health probes from a
# separate gateway origin like a static PQC entry page). Comma-separated;
# wildcards rejected when credentials are enabled (CORS spec).
CORS_ORIGINS=

# Other hostnames this app answers on besides RP_ORIGIN — a LAN name, a tailnet
# MagicDNS name. Without them, sign-ins and uploads from a second hostname are
# refused with 403 while page loads still work. Full origins, comma-separated,
# scheme and port included. Distinct from CORS_ORIGINS: that governs which
# origins may READ a response, this which may CHANGE state. RP_ORIGIN remains the
# origin used to build share links, emails and the sitemap.
# e.g. http://hermitstash.local:3081, https://box.tail1a2b3c.ts.net
ADDITIONAL_ORIGINS=

# ---- Authentication ----
# Enable local email/password login
LOCAL_AUTH=true
# Allow new users to self-register
REGISTRATION_OPEN=true
# Allow anonymous file uploads (no login required)
PUBLIC_UPLOAD=true

# ---- Passkey / WebAuthn ----
PASSKEY_ENABLED=true
# Your domain name (no protocol) — e.g. hermitstash.example.com
RP_ID=hermitstash.example.com
# Full origin URL — e.g. https://hermitstash.example.com
RP_ORIGIN=https://hermitstash.example.com

# ---- Google OAuth (leave empty to disable) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- OpenID Connect single sign-on (off by default) ----
# Works with Authentik, Keycloak, Authelia, Pocket ID, VoidAuth and other
# OpenID Connect providers. Register <RP_ORIGIN>/auth/oidc/callback as the
# redirect URI at the provider.
OIDC_ENABLED=false
# e.g. https://auth.example.com/application/o/hermitstash/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Defaults to <RP_ORIGIN>/auth/oidc/callback
OIDC_CALLBACK_URL=
OIDC_BUTTON_LABEL=Sign in with SSO
OIDC_SCOPES=openid email profile
# Auto-provisioning requires OIDC_ALLOWLIST or OIDC_REQUIRED_GROUP
OIDC_AUTO_PROVISION=false
OIDC_ALLOWLIST=
OIDC_GROUPS_CLAIM=groups
OIDC_REQUIRED_GROUP=
OIDC_ADMIN_GROUP=
# Create accounts from an email the provider does not mark verified (Microsoft
# Entra ID). Requires OIDC_REQUIRED_GROUP; never links an existing account.
OIDC_TRUST_UNVERIFIED_EMAIL=false
# CIDR ranges in which a plain-http issuer IP is accepted, e.g. 10.0.0.0/8
OIDC_ALLOW_INTERNAL=

# ---- Email / SMTP (leave empty to disable) ----
# Examples: smtp.gmail.com, smtp.mailgun.org, email-smtp.us-east-1.amazonaws.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address — e.g. noreply@hermitstash.example.com
SMTP_FROM=
# Require email verification before login
EMAIL_VERIFICATION=false

# ---- Storage ----
# "local" for disk, "s3" for S3-compatible (AWS, MinIO, R2, Backblaze)
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads
# Max file size in bytes (default 100MB)
MAX_FILE_SIZE=104857600
# Highest download limit a sender may set on a limited-download bundle (1 to 100)
MAX_BURN_READS=10

# ---- S3 (only when STORAGE_BACKEND=s3) ----
S3_BUCKET=
# e.g. us-east-1, eu-west-1, auto
S3_REGION=
# Custom endpoint for S3-compatible services (MinIO, R2, Backblaze)
# e.g. https://s3.us-east-1.amazonaws.com, https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
